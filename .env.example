# Docker Compose settings. Copy to .env beside docker-compose.yml; all are optional.
# GATEWAY_IMAGE=ghcr.io/m87techlabs/m87-ai-gateway:latest
# GATEWAY_BIND=127.0.0.1
# GATEWAY_PORT=8087
# GATEWAY_ADMIN_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Single sign-on. Off until the issuer is set; see docs/runbooks/single-sign-on.md.
# GATEWAY_OIDC_ISSUER=https://sso.example.com/realms/example
# GATEWAY_OIDC_CLIENT_ID=m87-gateway
# GATEWAY_OIDC_CLIENT_SECRET=
# GATEWAY_PUBLIC_URL=http://localhost:8087

# Monitoring profile. These always bind to 127.0.0.1.
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
